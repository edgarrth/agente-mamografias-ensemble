# Validated workstation profile retained in v0.23 — originally tested 2026-08-15
# Hardware/runtime actually tested: NVIDIA GeForce RTX 5060 Ti 16 GB,
# Docker/WSL, model-specific Blackwell images, PyTorch 2.7.1 + CUDA 12.8.
HOST_WORKSPACE=./workspace
POSTGRES_DB=mammography
POSTGRES_USER=mammography
POSTGRES_PASSWORD=mammography_research
DATABASE_URL=postgresql+psycopg://mammography:mammography_research@postgres:5432/mammography
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=mammography
MINIO_ROOT_PASSWORD=mammography_research
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mammography
MINIO_SECRET_KEY=mammography_research
MINIO_WEB_BUCKET=mammography-web
MINIO_WEB_ENABLED=true
MINIO_SECURE=false
MINIO_CONSOLE_PUBLIC_URL=http://localhost:9001
MODEL_RUNNER_URL=http://model-runner:8010
DOCKER_CLI_IMAGE=docker:29-cli

# Device selection is deployment configuration. GPU compatibility profiles remain
# model metadata in config/models.yaml and cannot be overridden from .env.
DEFAULT_MODEL_DEVICE=cpu
GMIC_DEVICE=gpu
NYU_DEVICE=gpu
GLAM_DEVICE=gpu
ALLOW_GPU=true
GPU_NUMBER=0

MODEL_BOOTSTRAP_MODE=lazy
DEFAULT_MAX_RUNTIME_MINUTES=120
RESOURCE_SAMPLE_SECONDS=2
LOG_LEVEL=INFO

# Web-only inference device; does not alter batch model device settings.
WEB_INFERENCE_DEVICE=cpu

# Web-only scratch space is a Docker volume, not a project workspace directory.
# Artifacts are durable only in PostgreSQL + MinIO; scratch files are removed after evaluation.
WEB_PERSIST_LOCAL=false
WEB_SCRATCH_TTL_MINUTES=60

# Web inference debug events are emitted to Docker stdout at LOG_LEVEL=INFO and include run_id.

# Stable Docker volume names. Keep these unchanged across project upgrades so PostgreSQL
# settings/history and MinIO evidence survive extraction into a new versioned directory.
POSTGRES_VOLUME_NAME=mammography-postgres-data
MINIO_VOLUME_NAME=mammography-minio-data
WEB_SCRATCH_VOLUME_NAME=mammography-web-scratch
