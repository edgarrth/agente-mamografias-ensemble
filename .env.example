HOST_WORKSPACE=./workspace
POSTGRES_DB=mammography
POSTGRES_USER=mammography
POSTGRES_PASSWORD=mammography_research
DATABASE_URL=postgresql+psycopg://mammography:mammography_research@postgres:5432/mammography
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=mammography
MINIO_ROOT_PASSWORD=mammography_research
MODEL_RUNNER_URL=http://model-runner:8010
DOCKER_CLI_IMAGE=docker:29-cli
# Device selection is a deployment concern. Profiles stay in config/models.yaml.
DEFAULT_MODEL_DEVICE=cpu
GMIC_DEVICE=cpu
NYU_DEVICE=cpu
GLAM_DEVICE=cpu
GPU_NUMBER=0
MODEL_BOOTSTRAP_MODE=lazy
DEFAULT_MAX_RUNTIME_MINUTES=120
RESOURCE_SAMPLE_SECONDS=2
LOG_LEVEL=INFO

# GPU is opt-in. A model can use GPU only after its configured profile passes gpu_probe.
ALLOW_GPU=false
