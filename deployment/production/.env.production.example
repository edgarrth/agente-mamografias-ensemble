# Mammography AI Agent v0.36.0 - Production CPU profile
# Copy to .env.production and replace every CHANGE_ME value.

# Prebuilt platform images. Publish them once from the validated workstation.
APP_IMAGE=edgarrth/mammography-agent-app:0.36.0
MODEL_RUNNER_IMAGE=edgarrth/mammography-agent-model-runner:0.36.0
EDGE_IMAGE=edgarrth/mammography-agent-edge:0.36.0
RUNTIME_ASSETS_IMAGE=edgarrth/mammography-runtime-assets:runtime-v1

# Model images in Docker Hub. The pull script retags them to the exact local names
# already expected by config/models.yaml, so no inference code/config flow changes.
GMIC_CPU_REMOTE_IMAGE=edgarrth/mammography-model-gmic:research
NYU_CPU_REMOTE_IMAGE=edgarrth/mammography-model-nyu:research
GLAM_CPU_REMOTE_IMAGE=edgarrth/mammography-model-glam:research
GMIC_BLACKWELL_REMOTE_IMAGE=edgarrth/mammography-model-gmic:blackwell-cu128-r3
NYU_BLACKWELL_REMOTE_IMAGE=edgarrth/mammography-model-nyu:blackwell-cu128-r1
GLAM_BLACKWELL_REMOTE_IMAGE=edgarrth/mammography-model-glam:blackwell-cu128-r2

# Infrastructure images. These can later be replaced by repository@sha256:digest
# after the deployment lock file is generated.
POSTGRES_IMAGE=postgres:16.15-alpine3.24
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest

POSTGRES_DB=mammography
POSTGRES_USER=mammography
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
DATABASE_URL=postgresql+psycopg://mammography:CHANGE_ME_POSTGRES@postgres:5432/mammography

MINIO_ROOT_USER=mammography-prod
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT
MINIO_ACCESS_KEY=mammography-prod
MINIO_SECRET_KEY=CHANGE_ME_MINIO_ROOT
MINIO_WEB_BUCKET=mammography-web

# Initial IP-only smoke test: :80
# With DNS configured, replace with e.g. mammography.example.com; Caddy will manage HTTPS.
APP_SITE_ADDRESS=:80
APP_BASIC_AUTH_USER=edgar
# IMPORTANT: keep the bcrypt hash single-quoted in .env.production so '$' remains literal.
APP_BASIC_AUTH_HASH='CHANGE_ME_CADDY_BCRYPT_HASH'

LOG_LEVEL=INFO
MODEL_BOOTSTRAP_MODE=lazy
RESOURCE_SAMPLE_SECONDS=2
DEFAULT_MAX_RUNTIME_MINUTES=120
WEB_SCRATCH_TTL_MINUTES=60

POSTGRES_VOLUME_NAME=mammography-postgres-data
MINIO_VOLUME_NAME=mammography-minio-data
WEB_SCRATCH_VOLUME_NAME=mammography-web-scratch
RUNTIME_WORKSPACE_VOLUME_NAME=mammography-runtime-workspace
CADDY_DATA_VOLUME_NAME=mammography-caddy-data
CADDY_CONFIG_VOLUME_NAME=mammography-caddy-config

